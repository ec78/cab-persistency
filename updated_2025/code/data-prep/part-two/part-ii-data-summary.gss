year_ldc = dtYear(pos_cab_grp_ldc[., datevar]);
pos_country_ct_ldc = asDf(unique(year_ldc)~counts(year_ldc, unique(year_ldc)), datevar, "Total");

// Unit root regimes
tmp_ldc = selif(pos_cab_grp_ldc, pos_cab_grp_ldc[., "Regime Type"] .== "Unit root");
