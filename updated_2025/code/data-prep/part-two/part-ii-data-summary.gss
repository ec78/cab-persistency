pos_cab_grp_ldc = selif(reg_2_data, reg_2_data[., interest_var] .> 0 .and reg_2_data[., "ldc"] .==1);

// Get  country count by year
year_idc = dtYear(pos_cab_grp_idc[., datevar]);
pos_country_ct_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "Total");

// Unit root regimes
tmp_idc = selif(pos_cab_grp_idc, pos_cab_grp_idc[., "Regime Type"] .== "Unit root");
year_idc = dtYear(tmp_idc[., datevar]);
pos_unit_rt_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Unit Root");

// Stationary regimes
tmp_idc = selif(pos_cab_grp_idc, pos_cab_grp_idc[., "Regime Type"] .== "Stationary");
year_idc = dtYear(tmp_idc[., datevar]);
pos_stationary_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Stationary");

// Explosive regimes
tmp_idc = selif(pos_cab_grp_idc, pos_cab_grp_idc[., "Regime Type"] .== "Explosive");
year_idc = dtYear(tmp_idc[., datevar]);
pos_explosive_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Explosive");

// Merge together
pos_regime_counts_idc = outerJoin(pos_country_ct_idc, datevar, pos_stationary_count_idc, datevar);
pos_regime_counts_idc = outerJoin(pos_regime_counts_idc, datevar, pos_unit_rt_count_idc, datevar);
pos_regime_counts_idc = outerJoin(pos_regime_counts_idc, datevar, pos_explosive_count_idc, datevar);
