pos_prct_counts_ldc = setColNames(pos_prct_counts_ldc, "Pct. Stationary"$|"Pct. Unit Root"$|"Pct. Explosive");

pos_regime_counts_ldc = pos_regime_counts_ldc[., datevar]~pos_prct_counts_ldc;

/*
* Negative CAB
*/
// Split to positive group
neg_cab_grp_idc = selif(reg_2_data, reg_2_data[., interest_var] .< 0 .and reg_2_data[., "idc"] .==1);
neg_cab_grp_ldc = selif(reg_2_data, reg_2_data[., interest_var] .< 0 .and reg_2_data[., "ldc"] .==1);

/*
** IDC
*/
// Get  country count by year
year_idc = dtYear(neg_cab_grp_idc[., datevar]);
neg_country_ct_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "Total");

// Unit root regimes IDC
tmp_idc = selif(neg_cab_grp_idc, neg_cab_grp_idc[., "Regime Type"] .== "Unit root");
year_idc = dtYear(tmp_idc[., datevar]);
neg_unit_rt_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Unit Root");

// Stationary regimes IDC
tmp_idc = selif(neg_cab_grp_idc, neg_cab_grp_idc[., "Regime Type"] .== "Stationary");
year_idc = dtYear(tmp_idc[., datevar]);
neg_stationary_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Stationary");

// Explosive regimes IDC
tmp_idc = selif(neg_cab_grp_idc, neg_cab_grp_idc[., "Regime Type"] .== "Explosive");
year_idc = dtYear(tmp_idc[., datevar]);
neg_explosive_count_idc = asDf(unique(year_idc)~counts(year_idc, unique(year_idc)), datevar, "No. Explosive");

// Merge together  IDC
neg_regime_counts_idc = outerJoin(neg_country_ct_idc, datevar, neg_stationary_count_idc, datevar);
neg_regime_counts_idc = outerJoin(neg_regime_counts_idc, datevar, neg_unit_rt_count_idc, datevar);
neg_regime_counts_idc = outerJoin(neg_regime_counts_idc, datevar, neg_explosive_count_idc, datevar);
neg_regime_counts_idc = missrv(neg_regime_counts_idc, 0);

