new;
cls;

#include code/cab_util.src 
/****************************************************************
** Data loading information
****************************************************************/
// Data loading path
fpath = "data/";
fpath_probs = "code/markov-switching/switching_jason/";

// Coefficient estimates
fname_results = "ms-estimates-new.csv";

// Annual cabdata
fname_cab = "cab_pct_annual.gdat";
fname_regimes = "clean-data/regimes_summary.gdat";


//fname_reg2;

//// Results saving paths
//fpath = "clean-data/";

// Variables of interest
groupvar = "cn";
group_names = "country_name";
datevar_1 = "Year";
datevar_2 = "year";
interest_var = "Pct CAB";


// Results saving paths
save_on = 0;
spath = "results/data-summaries/plots/data-summaries-ii/";
sfile1 = "regime-type-freq.png";
sfile2 = "regime-type-country-groups.png";
sfile3 = "regime-type-currency-groups.png";
sfile3b = "regime-type-currency-groups-split.png";
sfile4 = "regime-type-kaopen.png";
sfile5 = "regime-type-commd.png";
sfile6 = "regime-type-commd2.png";
sfile7 = "nfa_quant.png";
sfile7a = "idc_nfa_quant.png";
sfile7b = "ldc_nfa_quant.png";

/**************
Load data
****************/
// Regime data
regimes = loadd(fname_regimes);
regimes = asDate(regimes, "%Y", datevar_1);

// CAB data
reg_2_data = loadd(fpath $+ fname_cab);

// Merge the data 
reg_2_data = outerJoin(reg_2_data, datevar_2$|group_names, regimes, datevar_1$|group_names);

// Fill missing variables for all country groups
// Iterate over countries
// Set up asian and developing country indicator
adc = (reg_2_data[., "ldc"] .== 1 .and reg_2_data[., "eap"] .== 1);
reg_2_data = reg_2_data~asDF(adc, "adc");

/*
** Impute Country Group Variables
*/
string country_grps = { "idc", "emg", "ldc", "eap", "lac", "ez" };

///*
//** Check counts for variables of interest by country
//*/
//string var_interest = { "ka_open", "kaopen","fixed", "flexible", "nfa", "commd", "commd_i", "comd_d", "gsur", "gsur_18" };
//miss_table = pdCountMissings(reg_2_data, var_interest, "Country");
//saved(miss_table, spath $+ "missing_report.csv");

/*
** Get time spans
*/
//tspan_vars = pdTimeSpans(reg_2_data, datevar, "Country", interest_var);
//saved(tspan_vars, spath $+ "time_span_vars.csv");

/****************************************************************
** Total sample
** Basic summary statistics
****************************************************************/
// Regime type frequency
plotCanvasSize("px", 600|400);

frequency(reg_2_data, "Regime Type");
plotFreq(reg_2_data, "Regime Type", 0, 1);
plotAddFreqLabels(reg_2_data, "Regime Type", 0, 1);

if save_on;
    plotSave(spath $+ sfile1, 11|8.5, "in");
endif;

/****************************************************************
** Regime frequency by country group
****************************************************************/

string gr_title = {"Industrialized", "Emerging", "Less Developed", 
    "Latin American", "East Asian and Pacific", "Euro Zone" };

// Get Break Points
{ labels, keys } = getColLabels(reg_2_data, "Regime Type");

// Declare plotControl structure
struct plotControl myPlt;
myPlt = plotGetDefaults("bar");
plotCanvasSize("fill");

plotSetFonts(&myPlt, "all", "Times New Roman");

plotOpenWindow();
for i(1, rows(country_grps), 1);
    tst_data = selif(reg_2_data, reg_2_data[., country_grps[i]] .== 1);
    
    /*
    ** Frequency plot of regime type
    */
    // Set title
    plotSetTitle(&myPlt, gr_title[i]);
    plotSetYRange(&myPlt, 0, 100);
    
    plotLayout(3, 2, i);
    
    // Frequency plot
    // Draw histogram with default settings
    plotFreq(myPlt, tst_data, "Regime Type", 0, 1);
    plotAddFreqLabels(tst_data, "Regime Type", 0, 1);
    
endfor;

if save_on;
    plotSave(spath $+ sfile2, 11|8.5, "in");
endif;

/****************************************************************
** Regime frequency by year
***************************************************************/
datevar = datevar_2;
// Get  country count by year
year = dtYear(reg_2_data[., datevar]);
country_ct = asDf(unique(year)~counts(year, unique(year)), datevar, "Total");

// Unit root regimes
tmp = selif(reg_2_data, reg_2_data[., "Regime Type"] .== "Unit root");
year = dtYear(tmp[., datevar]);
unit_rt_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Unit Root");

// Stationary regimes
tmp = selif(reg_2_data, reg_2_data[., "Regime Type"] .== "Stationary");
year = dtYear(tmp[., datevar]);
stationary_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Stationary");

// Explosive regimes
tmp = selif(reg_2_data, reg_2_data[., "Regime Type"] .== "Explosive");
year = dtYear(tmp[., datevar]);
explosive_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Explosive");

// Merge together
regime_counts = outerJoin(country_ct, datevar, stationary_count, datevar, "full");
regime_counts = outerJoin(regime_counts, datevar, unit_rt_count, datevar, "full");
regime_counts = outerJoin(regime_counts, datevar, explosive_count, datevar, "full");
regime_counts = missrv(regime_counts, 0);

prct_counts = regime_counts[., 3 4 5]./regime_counts[., 2];
prct_counts = setColNames(prct_counts, "Pct. Stationary"$|"Pct. Unit Root"$|"Pct. Explosive");

regime_counts = regime_counts~prct_counts;

/*
** Horizontal bar plot
*/
plotClearLayout;
plotOpenWindow;

struct plotControl plt;
plt = plotGetDefaults("bar");

// Set up stacked bar
plotSetBar(&plt, 1, 1);

// Turn on legend
plotSetLegend(&plt, "Stationary"$|"Unit Root"$|"Explosive");

// Set Y Range
plotSetYRange(&plt, 0, 1);

// Set up X-axis
plotSetXTicInterval(&plt, 10, "years");

// Turn on title
plotSetTitle(&plt, "Percentage of Country By Regime Type");
plotBar(plt, regime_counts[., datevar], regime_counts[., 6 7 8]);
end; 
/****************************************************************
** Regime frequency by year and positive or negative CAB
***************************************************************/

/*
* Positive CAB
*/
// Split to positive group
pos_cab_grp = selif(reg_2_data, reg_2_data[., interest_var] .> 0);

// Get  country count by year
year = dtYear(pos_cab_grp[., datevar]);
pos_country_ct = asDf(unique(year)~counts(year, unique(year)), datevar, "Total");

// Unit root regimes
tmp = selif(pos_cab_grp, pos_cab_grp[., "Regime Type"] .== "Unit root");
year = dtYear(tmp[., datevar]);
pos_unit_rt_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Unit Root");

// Stationary regimes
tmp = selif(pos_cab_grp, pos_cab_grp[., "Regime Type"] .== "Stationary");
year = dtYear(tmp[., datevar]);
pos_stationary_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Stationary");

// Explosive regimes
tmp = selif(pos_cab_grp, pos_cab_grp[., "Regime Type"] .== "Explosive");
year = dtYear(tmp[., datevar]);
pos_explosive_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Explosive");

// Merge together
pos_regime_counts = outerJoin(pos_country_ct, datevar, pos_stationary_count, datevar);
pos_regime_counts = outerJoin(pos_regime_counts, datevar, pos_unit_rt_count, datevar);
pos_regime_counts = outerJoin(pos_regime_counts, datevar, pos_explosive_count, datevar);
pos_regime_counts = missrv(pos_regime_counts, 0);

pos_prct_counts = pos_regime_counts[., 3 4 5]./pos_regime_counts[., 2];
pos_prct_counts = setColNames(pos_prct_counts, "Pct. Stationary"$|"Pct. Unit Root"$|"Pct. Explosive");

pos_regime_counts =pos_regime_counts[., datevar]~pos_prct_counts;

/*
* Negative CAB
*/
// Split to positive group
neg_cab_grp = selif(reg_2_data, reg_2_data[., interest_var] .< 0);

// Get  country count by year
year = dtYear(neg_cab_grp[., datevar]);
neg_country_ct = asDf(unique(year)~counts(year, unique(year)), datevar, "Total");

// Unit root regimes
tmp = selif(neg_cab_grp, neg_cab_grp[., "Regime Type"] .== "Unit root");
year = dtYear(tmp[., datevar]);
neg_unit_rt_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Unit Root");

// Stationary regimes
tmp = selif(neg_cab_grp, neg_cab_grp[., "Regime Type"] .== "Stationary");
year = dtYear(tmp[., datevar]);
neg_stationary_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Stationary");

// Explosive regimes
tmp = selif(neg_cab_grp, neg_cab_grp[., "Regime Type"] .== "Explosive");
year = dtYear(tmp[., datevar]);
neg_explosive_count = asDf(unique(year)~counts(year, unique(year)), datevar, "No. Explosive");

// Merge together
neg_regime_counts = outerJoin(neg_country_ct, datevar, neg_stationary_count, datevar);
neg_regime_counts = outerJoin(neg_regime_counts, datevar, neg_unit_rt_count, datevar);
neg_regime_counts = outerJoin(neg_regime_counts, datevar, neg_explosive_count, datevar);
neg_regime_counts = missrv(neg_regime_counts, 0);

neg_prct_counts = neg_regime_counts[., 3 4 5]./neg_regime_counts[., 2];
neg_prct_counts = setColNames(neg_prct_counts, "Pct. Stationary"$|"Pct. Unit Root"$|"Pct. Explosive");

neg_regime_counts = neg_regime_counts[., datevar]~neg_prct_counts;


/*
** Horizontal bar plot
*/
plotClearLayout;
plotOpenWindow;

struct plotControl plt;
plt = plotGetDefaults("bar");

// Set up stacked bar
plotSetBar(&plt, 1, 1);

// Turn on legend
plotSetLegend(&plt, "Stationary"$|"Unit Root"$|"Explosive");

// Turn on title
plotLayout(1, 2, 1);
plotSetTitle(&plt, "Percentage of Negative CAB Countries By Regime Type");
plotSetXRange(&plt, 0, 1);
plotBarH(plt, neg_regime_counts[., datevar], neg_regime_counts[., 2 3 4]);

struct plotControl plt2;
plt2 = plotGetDefaults("bar");

// Set up stacked bar
plotLayout(1, 2, 2);
plotSetBar(&plt2, 1, 1);
plotSetXRange(&plt2, 0, 1);
plotSetTitle(&plt2, "Percentage of Positive CAB Countries By Regime Type");
plotBarH(plt2, pos_regime_counts[., datevar], pos_regime_counts[., 2 3 4]);

