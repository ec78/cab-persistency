year_ldc = dtYear(neg_cab_grp_ldc[., datevar]);
neg_country_ct_ldc = asDf(unique(year_ldc )~counts(year_ldc , unique(year_ldc)), datevar, "Total");

// Unit root regimes LDC
tmp = selif(neg_cab_grp_ldc, neg_cab_grp_ldc[., "Regime Type"] .== "Unit root");
year_ldc = dtYear(tmp[., datevar]);
